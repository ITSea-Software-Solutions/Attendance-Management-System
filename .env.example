# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=

# ─── Database ────────────────────────────────────────────────────────────────
DB_DATABASE=attendance_db
DB_USERNAME=ams_user
DB_PASSWORD=ams_secret
DB_ROOT_PASSWORD=root_secret

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost/api
FRONTEND_TARGET=dev

# ─── PDF Service ─────────────────────────────────────────────────────────────
PDF_SERVICE_URL=http://pdf-service:8001

# ─── Biometric (SecuGen HU20-AP via SGIBIOSRV) ───────────────────────────────
# Canonical path: browser → https://localhost:8443 (SecuGen SGIBIOSRV proxy,
# started with `py -3 biometric-agent/sgibiosrv_proxy.py`). Override if needed:
# VITE_SGIBIOSRV_URL=https://localhost:8443
#
# Simulation: set BOTH of these to true to demo the fingerprint flow WITHOUT a
# device (capture is faked client-side; matching is bypassed server-side).
# MUST stay false/unset in production.
VITE_BIOMETRIC_SIM=false
BIOMETRIC_SIM=false
# Server-side match threshold (SecuGen 0–200 scale); 40 is the recommended default.
BIOMETRIC_THRESHOLD=40

# (Legacy) The Node WebSocket agent on :12345 is NOT used by the frontend.
# VITE_BIOMETRIC_WS=ws://localhost:12345
